      <textAnnotation id="sid-0AED9A65-E9E6-487C-AE3A-0E7319562DCE" signavio:alignment="left" textFormat="text/plain">
         <extensionElements>
            <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
         </extensionElements>
         <text>D10 Channel (rule): Limit raise or requested amount &lt;= 1,300 -&gt; bank; otherwise mostly online. Online 64.8 % / bank 35.2 %</text>
      </textAnnotation>
      <textAnnotation id="sid-5A7AA6AC-334D-4BEE-9D1E-128B2EA0B479" signavio:alignment="left" textFormat="text/plain">
         <extensionElements>
            <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
         </extensionElements>
         <text>D13 Further O_Cancelled (one per open offer): 22.5 % / end 77.5 %</text>
      </textAnnotation>
      <textAnnotation id="sid-6CC308DB-092E-404C-9B98-D8AC6437CACC" signavio:alignment="left" textFormat="text/plain">
         <extensionElements>
            <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
         </extensionElements>
         <text>D12 W_Handle leads: manual 17.8 % / automatic 82.2 %</text>
      </textAnnotation>
      <textAnnotation id="sid-0B16A7C7-64DE-4057-BF18-85F82F411020" signavio:alignment="left" textFormat="text/plain">
         <extensionElements>
            <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
         </extensionElements>
         <text>D8 W_Complete application: started 93.9 % / skipped 6.1 %</text>
      </textAnnotation>
      <textAnnotation id="sid-68683F6E-3317-4E76-848A-B91CC8683B1B" signavio:alignment="left" textFormat="text/plain">
         <extensionElements>
            <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
         </extensionElements>
         <text>D11 Cancellation events (follows from outcome): 53.8 % / end 46.2 %</text>
      </textAnnotation>
      <textAnnotation id="sid-EF445457-9023-4FE0-B106-FA660469BB13" signavio:alignment="left" textFormat="text/plain">
         <extensionElements>
            <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
         </extensionElements>
         <text>D1 O_Sent: sent 89.5 % / skipped 10.5 %</text>
      </textAnnotation>
      <textAnnotation id="sid-BBA21953-8372-4FD5-94EE-98A6A33B4493" signavio:alignment="left" textFormat="text/plain">
         <extensionElements>
            <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
         </extensionElements>
         <text>D3 O_Sent again: 7.7 % / continue 92.3 %</text>
      </textAnnotation>
      <textAnnotation id="sid-A5AE1663-CE62-4189-80DA-26E6516F94B3" signavio:alignment="left" textFormat="text/plain">
         <extensionElements>
            <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
         </extensionElements>
         <text>D6 Call after offers (rule): first offer of a case -&gt; call; further offers while work is open -&gt; no call. Call 81.8 % / no call 18.2 %</text>
      </textAnnotation>
      <textAnnotation id="sid-7871E4FE-F4AA-4A32-AB20-720A8429EAC6" signavio:alignment="left" textFormat="text/plain">
         <extensionElements>
            <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
         </extensionElements>
         <text>D7 Offer returned: 61.3 % / not returned 38.7 % (30-day timer)</text>
      </textAnnotation>
      <textAnnotation id="sid-7265910C-1055-45D4-86EB-F92A01BABD73" signavio:alignment="left" textFormat="text/plain">
         <extensionElements>
            <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
         </extensionElements>
         <text>D4 W_Call incomplete files: call 59.2 % / no call 40.8 %</text>
      </textAnnotation>
      <textAnnotation id="sid-CB00849A-A186-4BF8-8937-344A39A7B31D" signavio:alignment="left" textFormat="text/plain">
         <extensionElements>
            <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
         </extensionElements>
         <text>D5 Further validation round: 39.4 % / exit 60.6 %</text>
      </textAnnotation>
      <textAnnotation id="sid-56C0E6F2-142C-4816-8F1D-FAD5B8688FF0" signavio:alignment="left" textFormat="text/plain">
         <extensionElements>
            <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
         </extensionElements>
         <text>D2 Further round of offers: 26.5 % / exit 73.5 %</text>
      </textAnnotation>
      <textAnnotation id="sid-2A40A08A-D936-46C8-8985-56B28DF71532" signavio:alignment="left" textFormat="text/plain">
         <extensionElements>
            <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
         </extensionElements>
         <text>D9 Outcome (rule): no activity after the last offer and nothing returned -&gt; Cancelled (30-day timer); returned + incomplete round -&gt; mostly Pending. Pending 54.9 % / Cancelled 33.2 % / Denied 11.9 %</text>
      </textAnnotation>
      <textAnnotation id="sid-C89157B7-D889-44EF-B81F-C0E5E974E4F5" signavio:alignment="left" textFormat="text/plain">
         <extensionElements>
            <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
         </extensionElements>
         <text>D14 A_Cancelled (follows from outcome): 70.1 % / skip 29.9 %</text>
      </textAnnotation>
   </process>
